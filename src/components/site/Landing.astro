---
import {
  ArrowRight,
  Check,
  ChevronDown,
  GitBranch,
  HardDrive,
  KeyRound,
  LayoutGrid,
  MonitorSmartphone,
  Palette,
  PanelsTopLeft,
  Sparkles,
  SquareDashedMousePointer,
  Swords,
  Users,
  WandSparkles,
  Download,
  X,
  Zap,
  ChartNoAxesColumn,
} from '@lucide/astro';
import { site, type SiteLang } from '@/site/i18n';
import Github from './GithubIcon.astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const c = site[lang];
const base = import.meta.env.BASE_URL;
const appHref = `${base}app/${lang === 'en' ? '?lang=en' : '?lang=fr'}`;
const otherLangHref = lang === 'fr' ? `${base}en/` : base;
const github = 'https://github.com/yoanbernabeu/NanoThumbnail';

const featureIcons = {
  wand: WandSparkles,
  mask: SquareDashedMousePointer,
  feed: PanelsTopLeft,
  score: ChartNoAxesColumn,
  ab: Swords,
  people: Users,
  brand: Palette,
  sparkles: Sparkles,
  palette: LayoutGrid,
} as const;
const localIcons = [HardDrive, KeyRound, MonitorSmartphone, Download];
const samples = [1, 2, 3, 4, 5, 6].map((n) => `${base}assets/sample${n}.webp`);

const btn =
  'inline-flex items-center justify-center gap-2 rounded-lg text-sm font-medium transition-colors outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50';
const btnPrimary = `${btn} bg-primary text-primary-foreground hover:bg-primary/90 h-10 px-5`;
const btnOutline = `${btn} border bg-background hover:bg-accent h-10 px-5`;
---

<!-- Nav -->
<header class="sticky top-0 z-40 border-b bg-background/80 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a href={lang === 'fr' ? base : `${base}en/`} class="flex items-center gap-2 font-semibold tracking-tight">
      <span class="flex size-7 items-center justify-center rounded-lg bg-primary text-primary-foreground">
        <Zap class="size-4" fill="currentColor" />
      </span>
      NanoThumbnail
    </a>
    <div class="hidden items-center gap-5 text-sm text-muted-foreground md:flex">
      <a href="#features" class="hover:text-foreground">{c.nav.features}</a>
      <a href="#pricing" class="hover:text-foreground">{c.nav.pricing}</a>
      <a href="#faq" class="hover:text-foreground">{c.nav.faq}</a>
    </div>
    <div class="ml-auto flex items-center gap-1">
      <a href={otherLangHref} hreflang={lang === 'fr' ? 'en' : 'fr'} class="rounded-md px-2.5 py-1.5 text-sm text-muted-foreground hover:bg-accent hover:text-foreground">
        {c.nav.switchLang}
      </a>
      <a href={github} class="rounded-md p-2 text-muted-foreground hover:bg-accent hover:text-foreground" aria-label={c.nav.github}>
        <Github class="size-4" />
      </a>
      <a href={appHref} class={`${btn} ml-2 h-8 bg-primary px-3 text-primary-foreground hover:bg-primary/90`}>{c.nav.open}</a>
    </div>
  </nav>
</header>

<main>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute inset-x-0 -top-40 h-[36rem] bg-[radial-gradient(ellipse_at_top,color-mix(in_oklch,var(--primary)_22%,transparent),transparent_65%)]"
    >
    </div>
    <div class="relative mx-auto max-w-6xl px-4 pt-20 pb-16 text-center sm:px-6 sm:pt-28">
      <a
        href="#features"
        class="inline-flex items-center gap-2 rounded-full border bg-card/60 px-3 py-1 text-xs font-medium text-muted-foreground backdrop-blur hover:text-foreground"
      >
        <span class="size-1.5 rounded-full bg-primary"></span>
        {c.hero.badge}
        <ArrowRight class="size-3" />
      </a>
      <h1 class="mx-auto mt-6 max-w-4xl text-4xl font-semibold tracking-tight text-balance sm:text-6xl">
        {c.hero.title}{' '}
        <span class="text-primary sm:block">{c.hero.titleAccent}</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base text-pretty text-muted-foreground sm:text-lg">{c.hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href={appHref} class={btnPrimary}>{c.hero.cta} <ArrowRight class="size-4" /></a>
        <a href={github} class={btnOutline}><Github class="size-4" /> {c.hero.secondary}</a>
      </div>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
        {
          c.hero.trust.map((item) => (
            <li class="flex items-center gap-1.5">
              <Check class="size-4 text-primary" />
              {item}
            </li>
          ))
        }
      </ul>

      <div class="relative mx-auto mt-14 max-w-5xl">
        <div class="overflow-hidden rounded-xl border bg-card shadow-2xl shadow-primary/10 ring-1 ring-black/5">
          <div class="flex h-8 items-center gap-1.5 border-b bg-muted/50 px-3">
            <span class="size-2.5 rounded-full bg-foreground/15"></span>
            <span class="size-2.5 rounded-full bg-foreground/15"></span>
            <span class="size-2.5 rounded-full bg-foreground/15"></span>
          </div>
          <img
            src={`${base}assets/studio.webp`}
            alt=""
            width="1500"
            height="800"
            class="block w-full"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="scroll-mt-16 border-t bg-sidebar py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-medium text-primary">{c.features.eyebrow}</p>
        <h2 class="mt-2 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{c.features.title}</h2>
        <p class="mt-4 text-pretty text-muted-foreground">{c.features.subtitle}</p>
      </div>
      <div class="mt-14 grid gap-px overflow-hidden rounded-xl border bg-border sm:grid-cols-2 lg:grid-cols-3">
        {
          c.features.items.map((f) => {
            const Icon = featureIcons[f.icon as keyof typeof featureIcons];
            return (
              <div class="bg-card p-6">
                <span class="flex size-9 items-center justify-center rounded-lg border bg-background text-primary">
                  <Icon class="size-4" />
                </span>
                <h3 class="mt-4 font-medium">{f.title}</h3>
                <p class="mt-1.5 text-sm text-muted-foreground">{f.desc}</p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Workflow -->
  <section class="py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="text-center text-3xl font-semibold tracking-tight sm:text-4xl">{c.workflow.title}</h2>
      <ol class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          c.workflow.steps.map((s, i) => (
            <li class="relative rounded-xl border bg-card p-5">
              <span class="tabular font-mono text-xs text-muted-foreground">0{i + 1}</span>
              <h3 class="mt-2 font-medium">{s.title}</h3>
              <p class="mt-1 text-sm text-muted-foreground">{s.desc}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Gallery -->
  <section class="border-t bg-sidebar py-24">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="text-center">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{c.gallery.title}</h2>
        <p class="mt-3 text-muted-foreground">{c.gallery.subtitle}</p>
      </div>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          samples.map((src) => (
            <img src={src} alt="" loading="lazy" decoding="async" class="aspect-video w-full rounded-lg border object-cover shadow-sm" />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Local-first -->
  <section class="py-24">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 sm:px-6 lg:grid-cols-[1fr_1.4fr] lg:items-center">
      <div>
        <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{c.local.title}</h2>
        <p class="mt-4 text-pretty text-muted-foreground">{c.local.subtitle}</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          c.local.items.map((item, i) => {
            const Icon = localIcons[i];
            return (
              <div class="rounded-xl border bg-card p-5">
                <Icon class="size-5 text-primary" />
                <h3 class="mt-3 font-medium">{item.title}</h3>
                <p class="mt-1 text-sm text-muted-foreground">{item.desc}</p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="scroll-mt-16 border-t bg-sidebar py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="text-center">
        <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{c.pricing.title}</h2>
        <p class="mt-3 text-muted-foreground">{c.pricing.subtitle}</p>
      </div>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        <div class="rounded-xl border-2 border-primary bg-card p-6 shadow-lg shadow-primary/10">
          <p class="font-medium">{c.pricing.ours.name}</p>
          <p class="mt-3 flex items-baseline gap-2">
            <span class="text-4xl font-semibold tracking-tight">{c.pricing.ours.price}</span>
            <span class="text-sm text-muted-foreground">{c.pricing.ours.unit}</span>
          </p>
          <p class="mt-2 text-xs text-muted-foreground">{c.pricing.ours.note}</p>
          <ul class="mt-6 space-y-2.5 text-sm">
            {
              c.pricing.ours.features.map((f) => (
                <li class="flex items-center gap-2">
                  <Check class="size-4 text-primary" />
                  {f}
                </li>
              ))
            }
          </ul>
          <a href={appHref} class={`${btnPrimary} mt-8 w-full`}>{c.pricing.ours.cta}</a>
        </div>
        <div class="rounded-xl border bg-card/60 p-6">
          <p class="font-medium text-muted-foreground">{c.pricing.theirs.name}</p>
          <p class="mt-3 flex items-baseline gap-2">
            <span class="text-4xl font-semibold tracking-tight text-muted-foreground">{c.pricing.theirs.price}</span>
            <span class="text-sm text-muted-foreground">{c.pricing.theirs.unit}</span>
          </p>
          <ul class="mt-8 space-y-2.5 text-sm text-muted-foreground">
            {
              c.pricing.theirs.features.map((f) => (
                <li class="flex items-center gap-2">
                  <X class="size-4" />
                  {f}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="scroll-mt-16 py-24">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="text-center text-3xl font-semibold tracking-tight sm:text-4xl">{c.faq.title}</h2>
      <div class="mt-10 divide-y rounded-xl border bg-card">
        {
          c.faq.items.map((item) => (
            <details class="group px-5 py-4 [&_summary::-webkit-details-marker]:hidden">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
                {item.q}
                <ChevronDown class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" />
              </summary>
              <p class="mt-3 text-sm text-pretty text-muted-foreground">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="px-4 pb-24 sm:px-6">
    <div class="relative mx-auto max-w-6xl overflow-hidden rounded-2xl border bg-card px-6 py-16 text-center">
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_bottom,color-mix(in_oklch,var(--primary)_18%,transparent),transparent_70%)]"
      >
      </div>
      <div class="relative">
        <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{c.cta.title}</h2>
        <p class="mt-3 text-muted-foreground">{c.cta.subtitle}</p>
        <a href={appHref} class={`${btnPrimary} mt-8`}>{c.cta.button} <ArrowRight class="size-4" /></a>
      </div>
    </div>
  </section>
</main>

<footer class="border-t">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 py-8 text-sm text-muted-foreground sm:flex-row sm:px-6">
    <p class="flex items-center gap-2">
      <GitBranch class="size-4" />
      {c.footer.made} <a href="https://yoandev.co" class="font-medium text-foreground hover:underline">YoanDev</a>
    </p>
    <nav class="flex flex-wrap gap-x-5 gap-y-2">
      <a href={`${base}legal-notice/`} class="hover:text-foreground">{c.footer.legal}</a>
      <a href={`${base}privacy-policy/`} class="hover:text-foreground">{c.footer.privacy}</a>
      <a href={`${base}terms-of-service/`} class="hover:text-foreground">{c.footer.terms}</a>
      <a href={github} class="hover:text-foreground">GitHub</a>
    </nav>
  </div>
</footer>
