          <div class="flex flex-wrap items-center gap-2 sm:gap-3">
            {
              [
                { src: img('step-1.webp'), pos: '60% 58%' },
                { src: img('variant-b.webp'), pos: '28% 55%' },
                { src: img('variant-c.webp'), pos: '68% 58%' },
                { src: img('variant-d.webp'), pos: '25% 55%' },
              ].map((face) => (
                <div class="aspect-square w-14 overflow-hidden rounded-xl ring-1 ring-border sm:w-20 sm:rounded-2xl">
                  <Image src={face.src} alt="" width={400} class="size-full scale-[1.9] object-cover" style={`object-position:${face.pos};transform-origin:${face.pos}`} />
