---
import {
  ArrowRight,
  ArrowDown,
  ArrowUpRight,
  Check,
  ChevronDown,
  Download,
  GitBranch,
  HardDrive,
  KeyRound,
  MonitorSmartphone,
  Palette,
  Type,
  Users,
  WandSparkles,
  X,
  Zap,
  Search,
  Star,
} from '@lucide/astro';
import { site, type SiteLang } from '@/site/i18n';
import { STYLES } from '@/app/lib/styles';
import Github from './GithubIcon.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  lang: SiteLang;
}

const { lang } = Astro.props;
const c = site[lang];
const base = import.meta.env.BASE_URL;
const landingImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/landing/*.webp', { eager: true });
const img = (name: string) => landingImages[`../../assets/landing/${name}`].default;
const shot = (name: string) => img(`${lang}-${name}.webp`);
// Gallery: one thumbnail per style preset, generated in the studio. `<id>-<lang>.webp` wins over `<id>.webp`
// for thumbnails whose text is language-specific.
const galleryImages = import.meta.glob<{ default: ImageMetadata }>('../../assets/gallery/*.webp', { eager: true });
const galleryImg = (id: string) =>
  (galleryImages[`../../assets/gallery/${id}-${lang}.webp`] ?? galleryImages[`../../assets/gallery/${id}.webp`]).default;
// The reaction example is the hero's final version (generated, then edited twice in the studio).
const gallery = STYLES.map((s) => ({
  id: s.id,
  style: s.name[lang],
  title: c.gallery.titles[s.id as keyof typeof c.gallery.titles],
  src: s.id === 'reaction' ? landingImages['../../assets/landing/step-3.webp'].default : galleryImg(s.id),
}));
const g = (id: string) => gallery.find((x) => x.id === id)!;
const appHref = `${base}app/?lang=${lang}`;
const otherLangHref = lang === 'fr' ? `${base}en/` : base;
const github = 'https://github.com/yoanbernabeu/NanoThumbnail';
const channel = 'https://www.youtube.com/@yoandevco';

// Star count fetched at build time; the badge is simply hidden if GitHub is unreachable.
let stars: number | undefined;
try {
  const res = await fetch('https://api.github.com/repos/yoanbernabeu/NanoThumbnail', { signal: AbortSignal.timeout(4000) });
  if (res.ok) stars = (await res.json()).stargazers_count;
} catch {
  stars = undefined;
}
const starsLabel = stars === undefined ? undefined : new Intl.NumberFormat(lang, { notation: 'compact' }).format(stars);

const marquee = ['gaming', 'cinematic', 'minimal', 'clay', 'vlog', 'finance', 'story', 'hyper', 'podcast'].map((id) => g(id).src);
const feedIds = ['tech', 'versus', 'ranking', 'gaming', 'finance'];
const durations = ['10:42', '14:05', '18:31', '27:12', '12:48'];
const feedCards = [
  { src: g(feedIds[0]).src, title: g(feedIds[0]).title, ch: c.feed.others[0].channel, meta: c.feed.others[0].meta, duration: durations[0] },
  { src: img('step-3.webp'), title: c.feed.yourTitle, ch: c.feed.channel, meta: c.feed.meta, duration: '16:20', mine: true },
  ...feedIds.slice(1).map((id, i) => ({ src: g(id).src, title: g(id).title, ch: c.feed.others[i + 1].channel, meta: c.feed.others[i + 1].meta, duration: durations[i + 1] })),
];
const rowImages: Record<string, ImageMetadata> = { mask: shot('mask'), score: shot('score'), compare: shot('compare') };

const btn =
  'inline-flex items-center justify-center gap-2 rounded-xl text-sm font-medium transition-all outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50';
const btnPrimary = `${btn} bg-primary text-primary-foreground shadow-lg shadow-primary/25 hover:bg-primary/90 hover:shadow-primary/40 h-11 px-6`;
const btnOutline = `${btn} border bg-background/60 backdrop-blur hover:bg-accent h-11 px-6`;
const featured = ['gaming', 'cinematic'];
const chip = 'rounded-2xl border bg-card/85 p-3 shadow-2xl shadow-black/20 backdrop-blur-md';
const eyebrow = 'text-sm font-medium text-primary';
const h2 = 'text-3xl font-semibold tracking-tight text-balance sm:text-5xl';
const circumference = 2 * Math.PI * 16;
---

<!-- Nav -->
<header class="sticky top-0 z-50 bg-background/70 backdrop-blur-xl">
  <nav class="mx-auto flex h-14 max-w-6xl items-center gap-6 px-4 sm:px-6">
    <a href={lang === 'fr' ? base : `${base}en/`} class="flex items-center gap-2 font-semibold tracking-tight">
      <span class="flex size-7 items-center justify-center rounded-lg bg-primary text-primary-foreground">
        <Zap class="size-4" fill="currentColor" />
      </span>
      NanoThumbnail
    </a>
    <div class="hidden items-center gap-5 text-sm text-muted-foreground md:flex">
      <a href="#features" class="hover:text-foreground">{c.nav.features}</a>
      <a href="#gallery" class="hover:text-foreground">{c.nav.gallery}</a>
      <a href="#agents" class="hover:text-foreground">{c.nav.agents}</a>
      <a href="#pricing" class="hover:text-foreground">{c.nav.pricing}</a>
      <a href="#faq" class="hover:text-foreground">{c.nav.faq}</a>
    </div>
    <div class="ml-auto flex items-center gap-1">
      <a href={otherLangHref} hreflang={lang === 'fr' ? 'en' : 'fr'} class="rounded-md px-2.5 py-1.5 text-sm text-muted-foreground hover:bg-accent hover:text-foreground">
        {c.nav.switchLang}
      </a>
      <a href={github} class="flex items-center gap-1.5 rounded-md p-2 text-sm text-muted-foreground hover:bg-accent hover:text-foreground" aria-label={starsLabel ? `${c.nav.github} ${starsLabel}` : c.nav.github}>
        <Github class="size-4" />
        {starsLabel && <span class="tabular hidden items-center gap-1 sm:flex"><Star class="size-3.5" />{starsLabel}</span>}
      </a>
      <a href={appHref} class={`${btn} ml-2 h-8 rounded-lg bg-primary px-3 text-primary-foreground hover:bg-primary/90 max-sm:hidden`}>{c.nav.open}</a>
    </div>
  </nav>
</header>

<main class="overflow-x-clip">
  <!-- ─── Hero ─────────────────────────────────────────── -->
  <section class="relative">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -top-14 overflow-hidden">
      <div class="absolute top-[-12rem] left-1/2 h-[36rem] w-[64rem] -translate-x-1/2 rounded-full bg-primary/20 blur-[140px]"></div>
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,var(--border)_1px,transparent_1px),linear-gradient(to_bottom,var(--border)_1px,transparent_1px)] [mask-image:radial-gradient(ellipse_at_top,black_30%,transparent_70%)] bg-[size:56px_56px] opacity-60"
      >
      </div>
    </div>

    <div class="relative mx-auto max-w-6xl px-4 pt-16 text-center sm:px-6 sm:pt-24">
      <a
        href="#features"
        class="inline-flex items-center gap-2 rounded-full border bg-card/60 py-1 pr-3 pl-1 text-xs font-medium text-muted-foreground backdrop-blur hover:text-foreground"
      >
        <span class="flex size-5 items-center justify-center rounded-full bg-primary text-primary-foreground"><Zap class="size-3" fill="currentColor" /></span>
        {c.hero.badge}
        <ArrowRight class="size-3" />
      </a>
      <h1 class="mx-auto mt-6 max-w-5xl text-5xl leading-[1.02] font-semibold tracking-tighter text-balance sm:text-7xl">
        {c.hero.title}{' '}
        <span class="text-primary sm:block">{c.hero.titleAccent}</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-base text-pretty text-muted-foreground sm:text-lg">{c.hero.subtitle}</p>
      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href={appHref} class={btnPrimary}>{c.hero.cta} <ArrowRight class="size-4" /></a>
        <a href="#iterate" class={btnOutline}>{c.hero.secondary} <ArrowDown class="size-4" /></a>
      </div>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-muted-foreground">
        {
          c.hero.trust.map((item) => (
            <li class="flex items-center gap-1.5">
              <Check class="size-4 text-primary" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Stage: the thumbnail with the studio's UI floating around it -->
    <div class="relative mx-auto mt-16 max-w-4xl px-6 sm:mt-20">
      <div class="relative">
        <div aria-hidden="true" class="absolute -inset-6 rounded-[2rem] bg-primary/25 blur-2xl"></div>
        <div class="relative overflow-hidden rounded-2xl shadow-2xl ring-1 ring-white/10">
          <Image
            src={img('step-1.webp')}
            alt=""
            widths={[480, 768, 1024, 1280]}
            sizes="(min-width: 896px) 848px, calc(100vw - 48px)"
            loading="eager"
            class="aspect-video w-full object-cover"
          />
          <Image
            src={img('step-2.webp')}
            alt=""
            widths={[480, 768, 1024, 1280]}
            sizes="(min-width: 896px) 848px, calc(100vw - 48px)"
            loading="eager"
            class="absolute inset-0 aspect-video w-full object-cover opacity-0 motion-safe:animate-hero-step-2"
          />
          <Image
            src={img('step-3.webp')}
            alt={c.alts.hero}
            widths={[480, 768, 1024, 1280]}
            sizes="(min-width: 896px) 848px, calc(100vw - 48px)"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 aspect-video w-full object-cover motion-safe:animate-hero-step-3"
          />
        </div>

        <!-- Score -->
        <div class={`${chip} absolute -top-6 -left-4 hidden items-center gap-3 sm:flex lg:-left-20 motion-safe:animate-float`}>
          <svg viewBox="0 0 40 40" class="size-11 -rotate-90">
            <circle cx="20" cy="20" r="16" fill="none" stroke-width="4" class="stroke-muted"></circle>
            <circle
              cx="20"
              cy="20"
              r="16"
              fill="none"
              stroke-width="4"
              stroke-linecap="round"
              class="stroke-success"
              stroke-dasharray={circumference}
              stroke-dashoffset={circumference * (1 - c.hero.chips.scoreValue / 100)}></circle>
          </svg>
          <div class="text-left">
            <p class="text-xs text-muted-foreground">{c.hero.chips.score}</p>
            <p class="tabular text-lg leading-none font-semibold">{c.hero.chips.scoreValue}<span class="text-sm text-muted-foreground">/100</span></p>
          </div>
        </div>

        <!-- Style -->
        <div class={`${chip} absolute top-10 -right-4 hidden items-center gap-2.5 sm:flex lg:-right-20 motion-safe:animate-float [animation-delay:1.5s]`}>
          <span class="flex size-8 items-center justify-center rounded-lg bg-primary/15 text-primary"><Palette class="size-4" /></span>
          <div class="text-left">
            <p class="text-xs text-muted-foreground">{c.hero.chips.style}</p>
            <p class="text-sm font-medium">{c.hero.chips.styleValue}</p>
          </div>
        </div>

        <!-- Edit conversation -->
        <div class={`${chip} absolute -bottom-10 -left-4 hidden w-64 space-y-2 text-left sm:block lg:-left-24 motion-safe:[animation:float_6s_ease-in-out_infinite,hero-step-2_12s_ease-in-out_infinite]`}>
          <div class="grid justify-items-end">
            <p class="col-start-1 row-start-1 w-fit rounded-xl rounded-br-sm bg-primary px-3 py-1.5 text-sm text-primary-foreground opacity-0 motion-safe:animate-hero-bubble-1">
              {c.hero.chips.edits[0]}
            </p>
            <p class="col-start-1 row-start-1 w-fit rounded-xl rounded-br-sm bg-primary px-3 py-1.5 text-sm text-primary-foreground motion-safe:animate-hero-bubble-2">
              {c.hero.chips.edits[1]}
            </p>
          </div>
          <p class="flex items-center gap-1.5 text-xs text-muted-foreground">
            <span class="flex size-4 items-center justify-center rounded-full bg-success text-white"><Check class="size-3" /></span>
            {c.hero.chips.editDone}
          </p>
        </div>

        <!-- Variants -->
        <div class={`${chip} absolute -right-4 -bottom-8 hidden sm:block lg:-right-16 motion-safe:animate-float [animation-delay:4.5s]`}>
          <div class="grid grid-cols-2 gap-1.5">
            {
              [img('variant-b.webp'), img('variant-c.webp'), img('variant-d.webp'), img('step-1.webp')].map((src, i) => (
                <Image src={src} alt="" width={160} class:list={['aspect-video w-20 rounded-md object-cover', i === 3 && 'ring-2 ring-primary']} />
              ))
            }
          </div>
          <p class="mt-2 flex items-center justify-between gap-3 text-xs text-muted-foreground">
            <span>{c.hero.chips.variants}</span><span class="font-medium text-foreground">{c.hero.chips.model}</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Marquee -->
    <div class="relative mt-24 [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]">
      <div class="flex w-max gap-4 motion-safe:animate-marquee hover:[animation-play-state:paused]">
        {
          [...marquee, ...marquee].map((src, i) => (
            <Image
              src={src}
              alt=""
              widths={[320, 640]}
              sizes="(min-width: 640px) 320px, 256px"
              aria-hidden={i >= marquee.length ? 'true' : undefined}
              class="aspect-video w-64 rounded-xl object-cover shadow-lg ring-1 ring-border sm:w-80"
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- ─── Studio ───────────────────────────────────────── -->
  <section id="features" class="scroll-mt-16 py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class={eyebrow}>{c.studio.eyebrow}</p>
        <h2 class={`mt-3 ${h2}`}>{c.studio.title}</h2>
        <p class="mt-5 text-lg text-pretty text-muted-foreground">{c.studio.subtitle}</p>
      </div>
      <div class="relative mt-14">
        <div aria-hidden="true" class="absolute inset-x-10 -bottom-10 h-40 rounded-full bg-primary/25 blur-3xl"></div>
        <div class="relative overflow-hidden rounded-2xl border bg-card shadow-2xl ring-1 ring-black/5">
          <div class="flex h-9 items-center gap-1.5 border-b bg-muted/60 px-4">
            <span class="size-3 rounded-full bg-[#ff5f57]"></span>
            <span class="size-3 rounded-full bg-[#febc2e]"></span>
            <span class="size-3 rounded-full bg-[#28c840]"></span>
            <span class="mx-auto hidden rounded-md bg-background/70 px-16 py-0.5 text-xs text-muted-foreground sm:block">nanothumbnail.com/app</span>
          </div>
          <Image src={shot('studio')} alt={c.alts.studio} quality={70} widths={[640, 1024, 1512]} sizes="(min-width: 1152px) 1152px, 100vw" class="block w-full" />
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Gallery: one thumbnail per style ─────────────── -->
  <section id="gallery" class="scroll-mt-16 pb-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class={eyebrow}>{c.gallery.eyebrow}</p>
        <h2 class={`mt-3 ${h2}`}>{c.gallery.title}</h2>
        <p class="mt-5 text-lg text-pretty text-muted-foreground">{c.gallery.subtitle}</p>
      </div>
      <ul class="-mx-4 mt-14 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 pb-2 [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-2 sm:gap-x-4 sm:gap-y-6 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-4">
        {
          [...gallery].sort((a, b) => +featured.includes(b.id) - +featured.includes(a.id)).map((item) => {
            const big = featured.includes(item.id);
            return (
              <li class:list={['group w-[78%] shrink-0 snap-start sm:w-auto', big && 'sm:col-span-2']}>
                <div class="overflow-hidden rounded-xl ring-1 ring-border">
                  <Image
                    src={item.src}
                    alt={item.title}
                    widths={big ? [560, 1120] : [320, 640]}
                    sizes={big ? '(min-width: 1024px) 560px, 100vw' : '(min-width: 1024px) 272px, 50vw'}
                    class="aspect-video w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </div>
                <p class="mt-2.5 text-xs font-medium text-primary">{item.style}</p>
                <p class:list={['mt-0.5 line-clamp-2 text-pretty', big ? 'font-medium' : 'text-sm']}>{item.title}</p>
              </li>
            );
          })
        }
      </ul>
      <p class="mt-10 text-center text-sm text-muted-foreground">{c.gallery.note}</p>
    </div>
  </section>

  <!-- ─── Iterate story ────────────────────────────────── -->
  <section id="iterate" class="relative scroll-mt-16 border-y bg-sidebar py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class={eyebrow}>{c.iterate.eyebrow}</p>
        <h2 class={`mt-3 ${h2}`}>{c.iterate.title}</h2>
        <p class="mt-5 text-lg text-pretty text-muted-foreground">{c.iterate.subtitle}</p>
      </div>
      <ol class="mt-16 grid items-start gap-6 md:grid-cols-3">
        {
          c.iterate.steps.map((step, i) => (
            <li class="relative">
              <div class="overflow-hidden rounded-xl shadow-xl ring-1 ring-border">
                <Image src={img(`step-${i + 1}.webp`)} alt={c.alts.steps[i]} widths={[400, 800]} sizes="(min-width: 768px) 368px, 100vw" class="aspect-video w-full object-cover" />
              </div>
              <div class="mt-4 flex items-start gap-3">
                <span class="tabular flex size-7 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-semibold text-primary-foreground">
                  {i + 1}
                </span>
                <div>
                  <p class="text-xs font-medium tracking-wide text-muted-foreground uppercase">{step.label}</p>
                  <p class="mt-0.5 font-medium">{step.text}</p>
                </div>
              </div>
              {i < 2 && (
                <span class="absolute top-[28%] -right-5 z-10 hidden size-8 items-center justify-center rounded-full border bg-background text-primary shadow md:flex">
                  <ArrowRight class="size-4" />
                </span>
              )}
              {i < 2 && (
                <span class="mx-auto mt-4 flex size-8 items-center justify-center rounded-full border bg-background text-primary md:hidden">
                  <ArrowDown class="size-4" />
                </span>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ─── Feature rows ─────────────────────────────────── -->
  <section class="py-28">
    <div class="mx-auto max-w-6xl space-y-28 px-4 sm:px-6">
      {
        c.rows.map((row, i) => (
          <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
            <div class:list={[i % 2 === 1 && 'lg:order-2']}>
              <p class={eyebrow}>{row.eyebrow}</p>
              <h3 class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{row.title}</h3>
              <p class="mt-4 text-lg text-pretty text-muted-foreground">{row.text}</p>
              <ul class="mt-6 space-y-2.5">
                {row.points.map((p) => (
                  <li class="flex items-center gap-2.5">
                    <span class="flex size-5 items-center justify-center rounded-full bg-primary/15 text-primary">
                      <Check class="size-3" />
                    </span>
                    {p}
                  </li>
                ))}
              </ul>
            </div>
            <div class="relative">
              <div aria-hidden="true" class="absolute -inset-6 rounded-[2rem] bg-primary/15 blur-3xl" />
              {row.key === 'score' ? (
                <div class="relative flex items-center">
                  <Image src={img('step-3.webp')} alt="" widths={[400, 800]} sizes="(min-width: 1024px) 400px, 72vw" class="aspect-video w-[72%] rounded-xl object-cover shadow-2xl ring-1 ring-border" />
                  <Image src={rowImages.score} alt={c.alts.score} widths={[340]} sizes="280px" class="-ml-[22%] w-[50%] rounded-xl border bg-card shadow-2xl ring-1 ring-black/10 [mask-image:linear-gradient(to_bottom,black_80%,transparent)]" />
                </div>
              ) : (
                <Image src={rowImages[row.key]} alt={row.key === 'mask' ? c.alts.mask : c.alts.compare} quality={70} widths={[560, 1120]} sizes="(min-width: 1024px) 544px, 100vw" class="relative w-full rounded-xl border shadow-2xl ring-1 ring-black/10" />
              )}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- ─── Feed preview ─────────────────────────────────── -->
  <section class="border-y bg-sidebar py-28">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-3xl text-center">
        <p class={eyebrow}>{c.feed.eyebrow}</p>
        <h2 class={`mt-3 ${h2}`}>{c.feed.title}</h2>
        <p class="mt-5 text-lg text-pretty text-muted-foreground">{c.feed.text}</p>
      </div>

      <div class="mt-14 grid items-end gap-8 lg:grid-cols-[1fr_auto]">
        <!-- Desktop feed -->
        <div class="overflow-hidden rounded-2xl border bg-[#0f0f0f] shadow-2xl">
          <div class="flex items-center gap-3 border-b border-white/10 px-4 py-3">
            <div class="flex gap-1.5 overflow-hidden">
              {
                c.feed.tabs.map((tab, i) => (
                  <span class:list={['shrink-0 rounded-lg px-3 py-1 text-xs', i === 0 ? 'bg-white text-black' : 'bg-white/10 text-white/80']}>{tab}</span>
                ))
              }
            </div>
            <span class="ml-auto hidden items-center gap-2 rounded-full border border-white/15 px-3 py-1 text-xs text-white/50 sm:flex">
              <Search class="size-3" /> YouTube
            </span>
          </div>
          <div class="grid gap-x-4 gap-y-6 p-5 sm:grid-cols-2 md:grid-cols-3" style="font-family: Roboto, Arial, sans-serif">
            {
              feedCards.map((card) => (
                <div>
                  <div class:list={['relative overflow-hidden rounded-xl', card.mine && 'ring-2 ring-primary ring-offset-2 ring-offset-[#0f0f0f]']}>
                    <Image src={card.src} alt="" widths={[320, 640]} sizes="(min-width: 768px) 260px, 50vw" class="aspect-video w-full object-cover" />
                    <span class="absolute right-1.5 bottom-1.5 rounded bg-black/80 px-1 text-[11px] font-medium text-white">{card.duration}</span>
                  </div>
                  <div class="mt-2.5 flex gap-2.5">
                    <span class:list={['size-8 shrink-0 rounded-full', card.mine ? 'bg-primary' : 'bg-white/15']} />
                    <div class="min-w-0">
                      <p class="line-clamp-2 text-sm leading-5 font-medium text-[#f1f1f1]">{card.title}</p>
                      <p class="mt-0.5 text-xs text-[#aaa]">
                        {card.ch} · {card.meta}
                      </p>
                    </div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Phone -->
