            <p class="flex items-center gap-2 font-medium"><Type class="size-4 text-primary" /> {c.bento.items.text.title}</p>
            <p class="mt-1 text-sm text-muted-foreground">{c.bento.items.text.text}</p>
          </div>
        </div>

        <!-- Local -->
