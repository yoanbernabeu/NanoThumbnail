---
import SiteLayout from '@layouts/SiteLayout.astro';
import Landing from '@components/site/Landing.astro';
import { site } from '@/site/i18n';

const base = import.meta.env.BASE_URL;
---

<SiteLayout lang="fr" title={site.fr.meta.title} description={site.fr.meta.description} alternates={{ fr: base, en: `${base}en/` }} home>
  <Landing lang="fr" />
</SiteLayout>
