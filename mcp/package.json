{
  "name": "nanothumbnail-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets an AI agent (Claude, Cursor…) drive the NanoThumbnail studio open in your browser.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "nanothumbnail-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "youtube",
    "thumbnail",
    "nano-banana"
  ],
  "homepage": "https://nanothumbnail.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoanbernabeu/NanoThumbnail.git",
    "directory": "mcp"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js --banner:js=\"#!/usr/bin/env node\"",
    "typecheck": "tsc --noEmit -p .",
    "prepublishOnly": "npm run typecheck && npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2"
  }
}
